# Copy this file to .env and fill in real values.
# Real secrets come from the Onshape Developer Portal: https://cad.onshape.com/appstore/dev-portal
# Never commit the real .env file.

# Onshape Developer Portal -> your OAuth application -> OAuth client ID
ONSHAPE_CLIENT_ID=replace-with-your-onshape-client-id

# Onshape Developer Portal -> your OAuth application -> OAuth client secret (shown once at creation)
ONSHAPE_CLIENT_SECRET=replace-with-your-onshape-client-secret

# Set to the /auth/onshape/callback URL of your ngrok HTTPS tunnel in dev (and your Render URL in
# prod); must also be added as an allowed redirect URI in the Developer Portal.
ONSHAPE_REDIRECT_URI=https://your-ngrok-subdomain.ngrok-free.app/auth/onshape/callback

# Generate a strong random string yourself, e.g.: openssl rand -hex 32
# Never use a hardcoded/default value.
SESSION_SECRET=replace-with-a-strong-random-string

PORT=3000

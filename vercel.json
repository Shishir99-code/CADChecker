{
  "version": 2,
  "regions": [
    "iad1"
  ],
  "services": {
    "cadchecker": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm install && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "cadchecker"
      }
    }
  ]
}
